# ==========================================
# ETAPA 1: Construcción (Build)
# ==========================================

FROM node:22-alpine AS builder

# Instalar pnpm v9 estable de manera segura (Valida hashes contra malware)
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Copiar archivos de dependencias desde la raíz de frontend_devops
COPY package.json pnpm-lock.yaml* ./

# Forzar la verificación criptográfica total de las librerías
RUN pnpm config set verify-store-integrity true

# Instalar dependencias congelando el lockfile de manera estricta
RUN pnpm install --frozen-lockfile

# Copiar todo el código fuente al contenedor (incluyendo la carpeta front_despacho-main)
COPY . .

# ¡AQUÍ ESTÁ EL TRUCO! Nos movemos a la subcarpeta donde Vite tiene el index.html para compilar
WORKDIR /app/front_despacho-main

# Construir la aplicación (Vite leerá el index.html local y creará la carpeta dist aquí)
RUN pnpm build

# ==========================================
# ETAPA 2: Servidor en Producción (Runtime)
# ==========================================
FROM nginx:1.25-alpine

# Copiar los archivos estáticos compilados desde la subcarpeta de la etapa anterior
COPY --from=builder /app/front_despacho-main/dist /usr/share/nginx/html

# --- BUENAS PRÁCTICAS DE SEGURIDAD ---
# Modificar permisos para que Nginx pueda correr con el usuario no-root 'nginx'
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

# Cambiar al usuario no-root
USER nginx

# Exponer el puerto estándar de Nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]