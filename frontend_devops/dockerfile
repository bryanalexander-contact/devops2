# ==========================================
# ETAPA 1: Construcción (Build)
# ==========================================
FROM node:22-alpine AS builder

# Configurar pnpm v9 seguro y estable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# ¡AQUÍ ESTÁ EL TRUCO DE AISLAMIENTO! 
# Copiamos ÚNICAMENTE el contenido de tu frontend real a la raíz de compilación.
# Al compilar desde './frontend_devops', metemos directamente lo que está en front_despacho-main.
COPY front_despacho-main/package.json ./

# Si tienes un lockfile dentro de front_despacho-main, lo copiamos. Si no, pnpm lo generará en limpio.
COPY front_despacho-main/pnpm-lock.yaml* ./

# Forzar la verificación de integridad criptográfica contra malware de todos los paquetes
RUN pnpm config set verify-store-integrity true

# Instala de forma limpia las dependencias que tu código de React real requiere
RUN pnpm install

# Copiamos el resto de los archivos fuentes de la subcarpeta directamente a /app
COPY front_despacho-main/ .

# Ahora sí: pnpm, Vite e index.html están en el mismo nivel (/app)
RUN pnpm build

# ==========================================
# ETAPA 2: Servidor en Producción (Runtime)
# ==========================================
FROM nginx:1.25-alpine

# Los archivos compilados ahora se generan en /app/dist de forma directa
COPY --from=builder /app/dist /usr/share/nginx/html

# --- BUENAS PRÁCTICAS DE SEGURIDAD (Exigido en Rúbrica) ---
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

USER nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]