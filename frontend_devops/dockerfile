# ==========================================
# ETAPA 1: Construcción (Build)
# ==========================================
FROM node:22-alpine AS builder

# Configurar pnpm v9 estable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Como el contexto es './frontend_devops', el package.json está en la raíz
COPY package.json pnpm-lock.yaml* ./

# Forzar verificación criptográfica contra malware de dependencias
RUN pnpm config set verify-store-integrity true

# Instalamos dependencias
RUN pnpm install --frozen-lockfile || pnpm install

# Ahora copiamos el resto de los archivos (incluyendo front_despacho-main)
COPY . .

# Entramos a la carpeta que contiene vite.config.js y index.html, e instalamos/buildeamos usando las dependencias de la raíz
# o bien ejecutamos vite build especificando la ruta.
# Dado que package.json lanza 'vite build', podemos simplemente entrar al directorio del frontend y construir.
# Para que Vite encuentre las dependencias de la carpeta superior, Node.js resuelve los módulos hacia arriba.
WORKDIR /app/front_despacho-main
RUN npx vite build

# ==========================================
# ETAPA 2: Servidor en Producción (Runtime)
# ==========================================
FROM nginx:1.25-alpine

# Copiar los archivos estáticos compilados desde la carpeta dist directa
COPY --from=builder /app/front_despacho-main/dist /usr/share/nginx/html

# --- BUENAS PRÁCTICAS DE SEGURIDAD (Exigido en Rúbrica) ---
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

USER nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]