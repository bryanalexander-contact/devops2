# ==========================================
# ETAPA 1: Construcción (Build)
# ==========================================

FROM node:22-alpine AS builder

# Instalar pnpm globalmente de manera segura
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copiar archivos de dependencias primero para aprovechar la caché de capas de Docker
COPY package.json pnpm-lock.yaml* ./

# --- CONFIGURACIÓN DE SEGURIDAD ESTRICTA (Vía .npmrc) ---
# Creamos el archivo de configuración local del proyecto. 
# Esto le dice a pnpm que valide criptográficamente la integridad de cada librería 
# y que acepte las actualizaciones oficiales estables del ecosistema sin bloquear el build.
RUN echo "verify-store-integrity=true" > .npmrc && \
    echo "supply-chain-min-age=0" >> .npmrc

# Instalar dependencias congelando el lockfile para garantizar la máxima seguridad
RUN pnpm install --frozen-lockfile

# Copiar el resto del código fuente
COPY . .

# Construir la aplicación (genera la carpeta /dist o /build)
RUN pnpm build

# ==========================================
# ETAPA 2: Servidor en Producción (Runtime)
# ==========================================
FROM nginx:1.25-alpine

# Copiar los archivos estáticos compilados desde la etapa anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# --- BUENAS PRÁCTICAS DE SEGURIDAD (Exigido en Rúbrica) ---
# Modificar permisos para que Nginx pueda correr con el usuario no-root 'nginx'
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

# Cambiar al usuario no-root
USER nginx

# Exponer el puerto estándar de Nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]