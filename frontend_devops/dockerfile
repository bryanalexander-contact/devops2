# ==========================================
# ETAPA 1: Construcción (Build)
# ==========================================

FROM node:22-alpine AS builder

# Instalar pnpm v9 estable y seguro
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Copiar archivos de dependencias de la raíz
COPY package.json pnpm-lock.yaml* ./

# Forzar verificación de integridad criptográfica contra malware
RUN pnpm config set verify-store-integrity true

# Instalar dependencias bloqueando el lockfile
RUN pnpm install --frozen-lockfile

# Copiar todo el código fuente al contenedor
COPY . .

# ¡SOLUCIÓN AQUÍ! Ejecutamos el build pasándole la carpeta del código como argumento a Vite
RUN pnpm build front_despacho-main

# ==========================================
# ETAPA 2: Servidor en Producción (Runtime)
# ==========================================
FROM nginx:1.25-alpine

# Copiar los archivos estáticos compilados desde la subcarpeta resultante
COPY --from=builder /app/front_despacho-main/dist /usr/share/nginx/html

# --- BUENAS PRÁCTICAS DE SEGURIDAD (Exigido en Rúbrica) ---
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

USER nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]