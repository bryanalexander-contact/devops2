# ==========================================
# ETAPA 1: Construcción (Build)
# ==========================================
FROM node:22-alpine AS builder

# Configurar pnpm v9 estable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Como el contexto es './frontend_devops', entramos directo a la subcarpeta interna
COPY front_despacho-main/package.json ./

# Copiamos el lockfile si existe en esa misma ruta
COPY front_despacho-main/pnpm-lock.yaml* ./

# Forzar verificación criptográfica contra malware de dependencias
RUN pnpm config set verify-store-integrity true

# Instalamos las dependencias aislando por completo el entorno local de esa carpeta
RUN pnpm install --ignore-workspace

# Ahora copiamos el resto de los archivos fuentes de la aplicación
COPY front_despacho-main/ .

# Compilamos de forma limpia (Vite encontrará su index.html en la raíz /app)
RUN pnpm build

# ==========================================
# ETAPA 2: Servidor en Producción (Runtime)
# ==========================================
FROM nginx:1.25-alpine

# Copiar los archivos estáticos compilados desde la carpeta dist directa
COPY --from=builder /app/dist /usr/share/nginx/html

# --- BUENAS PRÁCTICAS DE SEGURIDAD (Exigido en Rúbrica) ---
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx /usr/share/nginx/html

USER nginx
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]l